{
  "name": "easymem",
  "version": "0.3.1",
  "description": "A local LLM-wiki as an MCP server. The coding agent you already run does the writing; easymem does the storage, full-text search and knowledge graph. No API key.",
  "author": "zhangxiangliang",
  "keywords": [
    "mcp",
    "mcp-server",
    "memory",
    "agent-memory",
    "wiki",
    "llm-wiki",
    "knowledge-base",
    "knowledge-graph",
    "full-text-search",
    "bm25",
    "claude-code",
    "codex",
    "opencode",
    "ai",
    "知识库",
    "维基"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangxiangliang/easymem.git"
  },
  "homepage": "https://github.com/zhangxiangliang/easymem#readme",
  "bugs": "https://github.com/zhangxiangliang/easymem/issues",
  "type": "module",
  "main": "dist/mcp.js",
  "types": "dist/mcp.d.ts",
  "bin": {
    "easymem": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "prepack": "npm run build",
    "prepare": "husky",
    "dev": "tsx src/cli.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.js --coverage",
    "test:unit": "npm run test -- --runInBand",
    "ci": "npm run build && npm run typecheck && npm run test",
    "validate": "npm run lint && npm run ci",
    "validate:release": "npm run validate"
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "SKILL.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "graphology": "^0.26.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "semantic-release": "^25.0.9",
    "ts-jest": "^29.4.12",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0"
  },
  "license": "MIT"
}
